                                                        <TextBlock Margin="0,0,0,2" Foreground="#56616F" Text="Y" />
                                                        <TextBox Padding="6,3" Text="{Binding SelectedZone.RelativeY, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,4,0">
                                                        <TextBlock Margin="0,0,0,2" Foreground="#56616F" Text="W" />
                                                        <TextBox Padding="6,3" Text="{Binding SelectedZone.RelativeWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Margin="0,0,0,2" Foreground="#56616F" Text="H" />
                                                        <TextBox Padding="6,3" Text="{Binding SelectedZone.RelativeHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <Border
