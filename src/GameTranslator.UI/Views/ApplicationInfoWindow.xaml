<Window x:Class="GameTranslator.UI.Views.ApplicationInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:GameTranslator.UI.Localization"
        Foreground="{DynamicResource ThemeText}" Title="{loc:Text Taea8289dc9c8}" Width="600" Height="360" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ThemePage}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml"/>
            <ResourceDictionary Source="/GameTranslator.UI;component/Themes/Light.xaml"/>
        </ResourceDictionary.MergedDictionaries><loc:LocalizedTextConverter x:Key="LocalizedText"/></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Game Translator" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,20" TextWrapping="Wrap"><Run Text="{loc:Text T06629efecaad}"/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
        <TextBlock Grid.Row="2" Text="{loc:Text T23c9cf518e45}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Adapters, Converter={StaticResource LocalizedText}}" TextWrapping="Wrap"/></ScrollViewer>
        <TextBlock Grid.Row="4" Margin="0,16,0,12"><Hyperlink Foreground="{DynamicResource ThemeAccentText}" Click="OnProjectLinkClick">GitHub — Dementius-cell/Game-Translator</Hyperlink></TextBlock>
        <Button Grid.Row="5" Content="{loc:Text Ta7a4033657e8}" IsCancel="True" Width="90" Padding="8,5" HorizontalAlignment="Right"/>
    </Grid>
</Window>
