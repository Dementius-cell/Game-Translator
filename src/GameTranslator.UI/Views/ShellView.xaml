                                                                <TextBlock
                                                                    Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#56616F"
                                                                    Text="Auto follows vertical CJK geometry without a fixed column count; a numeric value is a hard limit."
                                                                    TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

