                                Foreground="{DynamicResource ThemeText}"
                                Text="{Binding WelcomeTourTitle, Converter={StaticResource LocalizedText}}"
                                TextWrapping="Wrap"/>
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource ThemeText}"
                                LineHeight="21"
                                Text="{Binding WelcomeTourBody, Converter={StaticResource LocalizedText}}"
                                TextWrapping="Wrap"/>
                            <Border
                                Grid.Row="4"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ThemeSelected}"
                                BorderBrush="{DynamicResource ThemeAccentText}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <DockPanel>
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ThemeAccentFill}"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource ThemeOnAccent}"
                                            Text="i"/>
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource ThemeMuted}"
                                        LineHeight="19"
                                        Text="{Binding WelcomeTourGuidance, Converter={StaticResource LocalizedText}}"
                                        TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="5" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ThemeMuted}"
                                    Text="{loc:Text Ta2f81edd8b82}"
                                    TextWrapping="Wrap"/>
                                <Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    Margin="8,0,0,0"
                                    Command="{Binding PreviousWelcomeTourStepCommand}"
                                    Content="{loc:Text T1a9fb1f3cf8e}"
                                    IsEnabled="{Binding WelcomeTourCanGoBack}"/>
                                <Button
                                    Grid.Column="2"
                                    MinWidth="104"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NextWelcomeTourStepCommand}"
                                    Content="{Binding WelcomeTourPrimaryActionText, Converter={StaticResource LocalizedText}}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
            </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ThemePage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Border
            x:Name="BugReportNotice"
            Grid.Row="0"
            Background="{DynamicResource ThemeWarningSurface}"
            BorderBrush="{DynamicResource ThemeWarning}"
            BorderThickness="0,0,0,1"
            Padding="16,10"
            Visibility="{Binding HasReportNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button
                    DockPanel.Dock="Right"
                    Content="{loc:Text Ta7a4033657e8}"
                    Margin="8,0,0,0"
                    Command="{Binding DismissReportNoticeCommand}"
                    VerticalAlignment="Center"/>
                <Button
                    DockPanel.Dock="Right"
                    Content="{loc:Text T7d0c4f43dc5b}"
                    Margin="8,0,0,0"
                    Command="{Binding OpenBugReportCommand}"
                    VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ReportNotice, Converter={StaticResource LocalizedText}}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ContentControl Grid.Row="1" Margin="0" Content="{Binding Navigation.CurrentViewModel}"/>
        <StatusBar Grid.Row="2" Padding="16,0" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <TextBlock Foreground="{DynamicResource ThemeMuted}" Text="{Binding StatusMessage, Converter={StaticResource LocalizedText}}" TextTrimming="CharacterEllipsis"/>
        </StatusBar>
    </Grid>
</UserControl>
