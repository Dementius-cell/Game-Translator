                                                            </StackPanel>
                                                            <TextBox
                                                                Padding="6,3"
                                                                Text="{Binding SelectedZone.OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Row="4"
                                                            Grid.Column="2"
