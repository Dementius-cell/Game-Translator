                                        Padding="6,3"
                                        Text="{Binding OverlayMaskColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <StackPanel
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Foreground="#253238" Text="Opacity" />
                                        <ContentControl
                                            Style="{StaticResource ParameterInfoIconStyle}"
                                            Tag="OverlayOpacity"
                                            Content="Непрозрачность маски: 0 делает её полностью прозрачной, 1 — полностью непрозрачной. Допустимый диапазон: 0–1 включительно." />
                                    </StackPanel>
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            Value="{Binding OverlayOpacity, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="6,3"
                                            Text="{Binding OverlayOpacity, UpdateSourceTrigger=PropertyChanged, StringFormat=F2, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Foreground="#253238" Text="Padding" />
                                        <ContentControl
                                            Style="{StaticResource ParameterInfoIconStyle}"
                                            Tag="OverlayPadding"
                                            Content="Дополнительный отступ маски вокруг исходного текста в пикселях. Допустимо 0 и выше; ползунок рассчитан на быстрый выбор 0–64." />
                                    </StackPanel>
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="64"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            LargeChange="4"
                                            Value="{Binding OverlayPadding, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="6,3"
                                            Text="{Binding OverlayPadding, UpdateSourceTrigger=PropertyChanged, StringFormat=F0, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,0"
                                        Foreground="#56616F"
                                        Text="Use #RRGGBB or #AARRGGBB for mask color. Sliders are for quick tuning; inputs stay available for exact values."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ZoneLiveWorkspaceCard"
                                Margin="0,6,0,0"
                                MaxWidth="1180"
                                Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding IsZonesOcrOrLiveDiagnosticsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel
                                        Grid.Row="0"
                                        LastChildFill="False"
                                        Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SectionTitleStyle}"
                                            Text="OCR zones" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#56616F"
                                            Text="{Binding ZoneSummary}" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Command="{Binding MoveSelectedZoneDownCommand}"
                                            Content="Later"
                                            Style="{StaticResource CompactButtonStyle}"
                                            ToolTip="Move the selected zone later in OCR processing order." />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Command="{Binding MoveSelectedZoneUpCommand}"
                                            Content="Earlier"
                                            Style="{StaticResource CompactButtonStyle}"
                                            ToolTip="Move the selected zone earlier in OCR processing order." />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Padding="9,4"
                                            Command="{Binding DuplicateSelectedZoneCommand}"
                                            Content="Duplicate" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Padding="9,4"
                                            Command="{Binding RemoveSelectedZoneCommand}"
                                            Content="Remove zone" />
                                        <Button
                                            x:Name="WelcomeTourPickScreenButton"
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Padding="9,4"
                                            Command="{Binding PickScreenZoneCommand}"
                                            Content="Pick screen" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Padding="9,4"
                                            Command="{Binding AddZoneCommand}"
                                            Content="Add zone" />
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <WrapPanel
                                            x:Name="ZoneResponsivePanels"
                                            Grid.Row="0"
                                            HorizontalAlignment="Left">
                                        <Border
                                            x:Name="OcrPreprocessingCard"
                                            Width="500"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Left"
                                            FlowDirection="LeftToRight"
                                            Style="{StaticResource SubtleCardBorderStyle}"
                                            Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="3"
                                                    Foreground="#253238"
                                                    FontWeight="SemiBold"
                                                    Text="OCR preprocessing" />
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,4,6,0">
                                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="OCR engine" />
                                                        <ContentControl
                                                            Style="{StaticResource ParameterInfoIconStyle}"
                                                            Tag="OcrEngine"
                                                            Content="OCR-движок профиля. Допустимые значения: Windows и Tesseract. Для вертикального текста и распознавания принятых candidate crop используется Tesseract." />
                                                    </StackPanel>
                                                    <ComboBox
                                                        Padding="6,3"
                                                        BorderBrush="{Binding OcrEngineBorderBrush}"
                                                        ItemsSource="{Binding OcrEngines}"
                                                        SelectedValue="{Binding OcrEngine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="{Binding OcrEngineValidationMessage}"
                                                        Validation.ErrorTemplate="{x:Null}" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Foreground="#A33A3A"
                                                        Text="{Binding OcrEngineValidationMessage}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding HasOcrEngineValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,4,6,0">
                                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Orientation" />
                                                        <ContentControl
                                                            Style="{StaticResource ParameterInfoIconStyle}"
                                                            Tag="OcrOrientation"
                                                            Content="Направление исходного текста. Допустимые значения: Auto, Horizontal и Vertical. Vertical доступен только для поддерживаемых японских и китайских языков." />
                                                    </StackPanel>
                                                    <ComboBox
                                                        Padding="6,3"
                                                        IsEnabled="{Binding IsOcrOrientationSelectionEnabled}"
                                                        ItemsSource="{Binding OcrOrientations}"
                                                        SelectedItem="{Binding OcrOrientationMode, Mode=TwoWay}"
                                                        ToolTip="{Binding OcrOrientationSelectionToolTip}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,4,0,0">
                                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Image preprocessing" />
                                                        <ContentControl
                                                            Style="{StaticResource ParameterInfoIconStyle}"
                                                            Tag="OcrPreprocessingPreset"
                                                            Content="Готовый набор обработки изображения: Custom, Off, Light 1,25×, Standard 1,5×, Strong 2× или Tiny source 3×. Выбор пресета заменяет ручные значения; ручная правка возвращает Custom." />
                                                    </StackPanel>
                                                    <ComboBox
                                                        Padding="6,3"
                                                        ItemsSource="{Binding OcrPreprocessingPresets}"
                                                        SelectedItem="{Binding SelectedOcrPreprocessingPreset, Mode=TwoWay}"
                                                        ToolTip="{Binding OcrPreprocessingPresetSummary}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,4,6,0"
                                                    Padding="6,3"
                                                    Content="Check OCR language"
                                                    Command="{Binding CheckOcrLanguagePackCommand}" />
                                                <Button
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,4,6,0"
                                                    Padding="6,3"
                                                    Command="{Binding InstallOcrLanguagePackCommand}"
                                                    Content="Install OCR language" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Margin="0,4,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#56616F"
                                                    Text="{Binding OcrLanguagePackStatus}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,4,6,0"
                                                    Orientation="Horizontal">
                                                    <CheckBox
                                                        Content="Enabled"
                                                        IsChecked="{Binding OcrPreprocessingEnabled, Mode=TwoWay}" />
                                                    <ContentControl
                                                        Style="{StaticResource ParameterInfoIconStyle}"
                                                        Tag="OcrPreprocessingEnabled"
                                                        Content="Включает применение выбранных параметров обработки перед OCR. Значения: включено или выключено; выключение передаёт исходный crop без этой обработки." />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,4,6,0"
                                                    Orientation="Horizontal">
                                                    <CheckBox
                                                        Content="Threshold"
                                                        IsChecked="{Binding OcrPreprocessingThresholdingEnabled, Mode=TwoWay}" />
                                                    <ContentControl
                                                        Style="{StaticResource ParameterInfoIconStyle}"
                                                        Tag="OcrThresholdingEnabled"
                                                        Content="Включает бинаризацию по заданному порогу Threshold. Значения: включено или выключено; числовой порог используется только во включённом состоянии." />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Margin="0,4,0,0"
                                                    Orientation="Horizontal">
                                                    <CheckBox
                                                        Content="Noise reduction"
                                                        IsChecked="{Binding OcrPreprocessingNoiseReductionEnabled, Mode=TwoWay}" />
                                                    <ContentControl
                                                        Style="{StaticResource ParameterInfoIconStyle}"
                                                        Tag="OcrNoiseReductionEnabled"
                                                        Content="Включает шумоподавление перед распознаванием. Значения: включено или выключено; может помочь на цветном фоне, но требует проверки на мелком тексте." />
                                                </StackPanel>
                                                <UniformGrid
                                                    Grid.Row="4"
                                                    Grid.ColumnSpan="3"
                                                    Margin="0,4,0,0"
                                                    Columns="5">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Contrast" />
                                                            <ContentControl
                                                                Style="{StaticResource ParameterInfoIconStyle}"
                                                                Tag="OcrContrast"
                                                                Content="Множитель контраста перед OCR. Допустимый диапазон: 0,5–3 включительно; 1 означает отсутствие изменения контраста." />
                                                        </StackPanel>
                                                        <TextBox Padding="6,3" Text="{Binding OcrPreprocessingContrast, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,4,0">
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Brightness" />
                                                            <ContentControl
                                                                Style="{StaticResource ParameterInfoIconStyle}"
                                                                Tag="OcrBrightness"
                                                                Content="Смещение яркости изображения перед OCR. Допустимый диапазон: −100–100 включительно; 0 означает отсутствие изменения." />
                                                        </StackPanel>
                                                        <TextBox Padding="6,3" Text="{Binding OcrPreprocessingBrightness, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,4,0">
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Sharpness" />
                                                            <ContentControl
                                                                Style="{StaticResource ParameterInfoIconStyle}"
                                                                Tag="OcrSharpness"
                                                                Content="Интенсивность повышения резкости перед OCR. Допустимый диапазон: 0–2 включительно; 0 отключает усиление резкости." />
                                                        </StackPanel>
                                                        <TextBox Padding="6,3" Text="{Binding OcrPreprocessingSharpness, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,4,0">
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Threshold" />
                                                            <ContentControl
                                                                Style="{StaticResource ParameterInfoIconStyle}"
                                                                Tag="OcrThreshold"
                                                                Content="Порог бинаризации яркости. Допустимый диапазон: 0–255 включительно; применяется только при включённом флажке Threshold." />
                                                        </StackPanel>
                                                        <TextBox Padding="6,3" Text="{Binding OcrPreprocessingThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Scale" />
                                                            <ContentControl
                                                                Style="{StaticResource ParameterInfoIconStyle}"
                                                                Tag="OcrScale"
                                                                Content="Масштабирование crop перед OCR. Допустимый диапазон: 1–3× включительно; больший масштаб помогает мелкому тексту, но увеличивает время обработки." />
                                                        </StackPanel>
                                                        <TextBox Padding="6,3" Text="{Binding OcrPreprocessingScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>


                                        <Border
                                            x:Name="ZoneSurfaceCard"
                                            Width="540"
                                            HorizontalAlignment="Left"
                                            FlowDirection="LeftToRight"
                                            Style="{StaticResource SubtleCardBorderStyle}"
                                            Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock
                                                    Foreground="#253238"
                                                    FontWeight="SemiBold"
                                                    Text="Interactive zone surface" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Foreground="#56616F"
                                                    Text="{Binding ZoneSurfaceSummary}" />
                                                <TextBlock
                                                    Margin="0,2,0,6"
                                                    Foreground="#56616F"
                                                    Text="Drag empty space to create a zone. Drag a zone to move it. Drag its lower-right handle to resize it."
                                                    TextWrapping="Wrap" />

                                                <Viewbox
                                                    Width="490"
                                                    Height="275.625"
                                                    HorizontalAlignment="Left"
                                                    Stretch="Uniform">
                                                    <Border
                                                        Width="{Binding ZoneSurfaceWidth}"
                                                        Height="{Binding ZoneSurfaceHeight}"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        SnapsToDevicePixels="True">
                                                        <Canvas
                                                        Background="#F8FAFC"
                                                        ClipToBounds="True"
                                                        MouseLeftButtonDown="OnZoneSurfaceMouseLeftButtonDown"
                                                        MouseLeftButtonUp="OnZoneSurfaceMouseLeftButtonUp"
                                                        MouseMove="OnZoneSurfaceMouseMove">
                                                        <Rectangle
                                                            Width="{Binding ZoneSurfaceWidth}"
                                                            Height="{Binding ZoneSurfaceHeight}"
                                                            Fill="#F8FAFC"
                                                            Stroke="#E2E8F0"
                                                            StrokeDashArray="4,4" />

                                                        <ItemsControl ItemsSource="{Binding OcrZones}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding SurfaceX}" />
                                                                    <Setter Property="Canvas.Top" Value="{Binding SurfaceY}" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid
                                                                        Width="{Binding SurfaceWidth}"
                                                                        Height="{Binding SurfaceHeight}"
                                                                        Cursor="SizeAll"
                                                                        MouseLeftButtonDown="OnZoneSurfaceZoneMouseLeftButtonDown"
                                                                        Tag="{Binding Id}">
                                                                        <Border
                                                                            Background="#3390CDF4"
                                                                            BorderThickness="2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Background" Value="#554F46E5" />
                                                                                            <Setter Property="BorderBrush" Value="#312E81" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>

                                                                        <TextBlock
                                                                            Margin="6,4,6,0"
                                                                            VerticalAlignment="Top"
                                                                            Foreground="#FFFFFF"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding DisplayName}"
                                                                            TextTrimming="CharacterEllipsis" />

                                                                        <Border
                                                                            Width="10"
                                                                            Height="10"
                                                                            Background="#FFFFFF"
                                                                            BorderBrush="#312E81"
                                                                            BorderThickness="1"
                                                                            Canvas.Left="{Binding SurfaceHandleX}"
                                                                            Canvas.Top="{Binding SurfaceHandleY}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            MouseLeftButtonDown="OnZoneResizeHandleMouseLeftButtonDown"
                                                                            Tag="{Binding Id}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border
                                                            Canvas.Left="{Binding ZoneSelectionPreviewX}"
                                                            Canvas.Top="{Binding ZoneSelectionPreviewY}"
                                                            Width="{Binding ZoneSelectionPreviewWidth}"
                                                            Height="{Binding ZoneSelectionPreviewHeight}"
                                                            Background="#2290CDF4"
                                                            BorderBrush="#0F766E"
                                                            BorderThickness="2"
                                                            Visibility="{Binding HasZoneSelectionPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Canvas>
                                                    </Border>
                                                </Viewbox>
                                            </StackPanel>
                                        </Border>
                                        </WrapPanel>

                                        <Grid
                                            x:Name="SelectedZoneParametersPanel"
                                            Grid.Row="2"
                                            MaxWidth="1112"
                                            HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Background="#F9FBFD"
                                                BorderBrush="#D7DEE8"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                        <Setter Property="IsEnabled" Value="{Binding HasSelectedZone}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLiveDiagnosticsTabSelected}" Value="True">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                <Setter Property="IsEnabled" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="#253238"
                                                        Text="Zone name"
                                                        Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ContentControl
                                                        Style="{StaticResource ParameterInfoIconStyle}"
                                                        Tag="ZoneName"
                                                        Content="Имя выбранной OCR-зоны в профиле. Поле обязательно; фиксированного ограничения длины нет." />
                                                </StackPanel>
                                                <TextBox
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="6,3"
                                                    Text="{Binding SelectedZone.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                    Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <Border
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,6,0,0"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D7DEE8"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Foreground="#253238"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding SelectedZone.DisplayName}" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.AbsoluteBoundsSummary}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.RelativeBoundsSummary}" />
