                                                                Content="Включает курсивное начертание перевода для выбранной зоны. Значения: включено или выключено." />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,6,4,0">
