                                                        <TextBlock Margin="0,0,0,2" Foreground="#56616F" Text="H" />
                                                        <TextBox Padding="6,3" Text="{Binding SelectedZone.AbsoluteHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
