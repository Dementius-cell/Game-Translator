<UserControl x:Class="GameTranslator.UI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:GameTranslator.UI.Behaviors"
             xmlns:viewModels="clr-namespace:GameTranslator.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#FFF8F8" />
                    <Setter Property="BorderBrush" Value="#C84B4B" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#C84B4B" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type viewModels:MainViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#253238"
                                Text="Profiles" />
                            <Button
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding RefreshProfilesCommand}"
                                Content="Refresh" />
                            <Button
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportProfileCommand}"
                                Content="Import" />
                            <Button
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ExportSelectedProfileCommand}"
                                Content="Export" />
                            <Button
                                DockPanel.Dock="Right"
                                Padding="12,6"
                                Command="{Binding BeginCreateProfileCommand}"
                                Content="New" />
                        </DockPanel>

                        <Border
                            Grid.Row="1"
                            Margin="0,12,0,12"
                            Background="#F6F8FA"
                            CornerRadius="4"
                            Padding="12">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#56616F"
                                    Text="Active profile" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontWeight="SemiBold"
                                    Foreground="#253238"
                                    Text="{Binding ActiveProfileName}" />
                            </StackPanel>
                        </Border>

                        <ListBox
                            Grid.Row="2"
                            Background="#FDFDFD"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="#253238"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="#56616F"
                                                Text="{Binding TranslatorSettings.TargetLanguage}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Grid.Row="3" Margin="0,12,0,0" Columns="2">
                            <Button
                                Margin="0,0,6,0"
                                Padding="12,6"
                                Command="{Binding CloneSelectedProfileCommand}"
                                Content="Clone" />
                            <Button
                                Margin="6,0,0,0"
                                Padding="12,6"
                                Command="{Binding DeleteSelectedProfileCommand}"
                                Content="Delete" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="#253238"
                                    Text="{Binding EditorTitle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="#56616F"
                                    Text="{Binding ProfileSummary}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,16,0,16"
                                Foreground="#2A5D67"
                                Text="{Binding StatusMessage}" />

                            <Border
                                Margin="0,0,0,16"
                                Background="#FFF4F4"
                                BorderBrush="#E3B4B4"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,2,0,2"
                                                Foreground="#8B1E1E"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Name" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="8,6"
                                        Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Top"
                                        Foreground="#253238"
                                        Text="Description" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="8,6"
                                        AcceptsReturn="True"
                                        Height="88"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,16,0,0"
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#253238"
                                        Text="Overlay preview" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        Padding="12,6"
                                        Command="{Binding ShowOverlayPreviewCommand}"
                                        Content="Show test overlay" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="8,12,0,0"
                                        Padding="12,6"
                                        Command="{Binding HideOverlayPreviewCommand}"
                                        Content="Hide overlay" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="12,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#56616F"
                                        Text="{Binding OverlayPreviewStatus}" />
                                    <CheckBox
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Content="Debug metrics"
                                        IsChecked="{Binding IsDebugOverlayEnabled, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="12,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#56616F"
                                        Text="{Binding DebugOverlayStatus}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,16,0,0"
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#253238"
                                        Text="Global hotkeys" />
                                    <ItemsControl
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Margin="0,12,0,0"
                                        ItemsSource="{Binding HotkeyBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Foreground="#253238"
                                                        Text="{Binding DisplayName}" />
                                                    <CheckBox
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Content="Enabled"
                                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Padding="8,6"
                                                        Text="{Binding GestureText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,8,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="#56616F"
                                        Text="{Binding GlobalHotkeyStatus}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="8,8,0,0"
                                        Padding="12,6"
                                        Command="{Binding ResetGlobalHotkeysCommand}"
                                        Content="Reset" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="8,8,0,0"
                                        Padding="12,6"
                                        Command="{Binding ApplyGlobalHotkeysCommand}"
                                        Content="Apply" />
                                </Grid>
                            </Border>
                            <Border
                                Margin="0,16,0,0"
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#253238"
                                        Text="Translator settings" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,24,0,0"
                                        Foreground="#56616F"
                                        Text="{Binding TranslatorSettingsSummary}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Provider" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        IsEditable="True"
                                        ItemsSource="{Binding TranslatorProviderOptions}"
                                        Text="{Binding TranslatorProvider, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Source language" />
                                    <ComboBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        IsEditable="True"
                                        ItemsSource="{Binding LanguageOptions}"
                                        Text="{Binding SourceLanguage, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Target language" />
                                    <ComboBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        IsEditable="True"
                                        ItemsSource="{Binding LanguageOptions}"
                                        Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Endpoint" />
                                    <TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        Text="{Binding TranslatorCredentialEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Project / folder id" />
                                    <TextBox
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        Text="{Binding TranslatorCredentialProjectId, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Region / location" />
                                    <TextBox
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        Text="{Binding TranslatorCredentialLocation, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="API key / token" />
                                    <PasswordBox
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        behaviors:PasswordBoxBinding.IsEnabled="True"
                                        behaviors:PasswordBoxBinding.BoundPassword="{Binding TranslatorCredentialSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                        <Button
                                            MinWidth="120"
                                            Command="{Binding SaveTranslatorCredentialsCommand}"
                                            Content="Save credentials" />
                                        <Button
                                            MinWidth="88"
                                            Margin="8,0,0,0"
                                            Command="{Binding ValidateTranslatorCredentialsCommand}"
                                            Content="Validate" />
                                        <Button
                                            MinWidth="80"
                                            Margin="8,0,0,0"
                                            Command="{Binding DeleteTranslatorCredentialsCommand}"
                                            Content="Delete" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="9"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        Foreground="#56616F"
                                        Text="{Binding TranslatorCredentialStatus}" />

                                    <TextBlock
                                        Grid.Row="10"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        Foreground="#56616F"
                                        Text="Common providers and language codes are prefilled, but values remain editable for future integrations." />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,16,0,0"
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#253238"
                                        Text="Overlay settings" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Mask mode" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="6,4"
                                        ItemsSource="{Binding OverlayMaskModes}"
                                        SelectedItem="{Binding OverlayMaskMode}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#253238"
                                        Text="Mask color" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="8,6"
                                        Text="{Binding OverlayMaskColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Top"
                                        Foreground="#253238"
                                        Text="Opacity" />
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            Value="{Binding OverlayOpacity, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="8,6"
                                            Text="{Binding OverlayOpacity, UpdateSourceTrigger=PropertyChanged, StringFormat=F2, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Top"
                                        Foreground="#253238"
                                        Text="Padding" />
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="64"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            LargeChange="4"
                                            Value="{Binding OverlayPadding, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="8,6"
                                            Text="{Binding OverlayPadding, UpdateSourceTrigger=PropertyChanged, StringFormat=F0, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        Foreground="#56616F"
                                        Text="Use #RRGGBB or #AARRGGBB for mask color. Sliders are for quick tuning, inputs stay available for exact values." />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,16,0,0"
                                BorderBrush="#E3E8EE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#253238"
                                            Text="OCR zones" />
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#56616F"
                                            Text="{Binding ZoneSummary}" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Command="{Binding MoveSelectedZoneDownCommand}"
                                            Content="Down" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Command="{Binding MoveSelectedZoneUpCommand}"
                                            Content="Up" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Command="{Binding DuplicateSelectedZoneCommand}"
                                            Content="Duplicate" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Command="{Binding RemoveSelectedZoneCommand}"
                                            Content="Remove zone" />
                                        <Button
                                            DockPanel.Dock="Right"
                                            Padding="12,6"
                                            Command="{Binding AddZoneCommand}"
                                            Content="Add zone" />
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Background="#F9FBFD"
                                            BorderBrush="#D7DEE8"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="3"
                                                    Foreground="#253238"
                                                    FontWeight="SemiBold"
                                                    Text="OCR preprocessing" />
                                                <CheckBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,10,12,0"
                                                    Content="Enabled"
                                                    IsChecked="{Binding OcrPreprocessingEnabled, Mode=TwoWay}" />
                                                <CheckBox
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,10,12,0"
                                                    Content="Threshold"
                                                    IsChecked="{Binding OcrPreprocessingThresholdingEnabled, Mode=TwoWay}" />
                                                <CheckBox
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,10,0,0"
                                                    Content="Noise reduction"
                                                    IsChecked="{Binding OcrPreprocessingNoiseReductionEnabled, Mode=TwoWay}" />
                                                <UniformGrid
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="3"
                                                    Margin="0,10,0,0"
                                                    Columns="5">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Contrast" />
                                                        <TextBox Padding="8,6" Text="{Binding OcrPreprocessingContrast, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Brightness" />
                                                        <TextBox Padding="8,6" Text="{Binding OcrPreprocessingBrightness, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Sharpness" />
                                                        <TextBox Padding="8,6" Text="{Binding OcrPreprocessingSharpness, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Threshold" />
                                                        <TextBox Padding="8,6" Text="{Binding OcrPreprocessingThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Scale" />
                                                        <TextBox Padding="8,6" Text="{Binding OcrPreprocessingScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>


                                        <Border
                                            Grid.Row="2"
                                            Background="#F9FBFD"
                                            BorderBrush="#D7DEE8"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                            <StackPanel>
                                                <TextBlock
                                                    Foreground="#253238"
                                                    FontWeight="SemiBold"
                                                    Text="Interactive zone surface" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Foreground="#56616F"
                                                    Text="{Binding ZoneSurfaceSummary}" />
                                                <TextBlock
                                                    Margin="0,4,0,12"
                                                    Foreground="#56616F"
                                                    Text="Drag on the surface to create a zone. Click a zone to select it. Drag the lower-right handle to resize the selected zone." />

                                                <Border
                                                    Width="{Binding ZoneSurfaceWidth}"
                                                    Height="{Binding ZoneSurfaceHeight}"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    SnapsToDevicePixels="True">
                                                    <Canvas
                                                        Background="#F8FAFC"
                                                        ClipToBounds="True"
                                                        MouseLeftButtonDown="OnZoneSurfaceMouseLeftButtonDown"
                                                        MouseLeftButtonUp="OnZoneSurfaceMouseLeftButtonUp"
                                                        MouseMove="OnZoneSurfaceMouseMove">
                                                        <Rectangle
                                                            Width="{Binding ZoneSurfaceWidth}"
                                                            Height="{Binding ZoneSurfaceHeight}"
                                                            Fill="#F8FAFC"
                                                            Stroke="#E2E8F0"
                                                            StrokeDashArray="4,4" />

                                                        <ItemsControl ItemsSource="{Binding OcrZones}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding SurfaceX}" />
                                                                    <Setter Property="Canvas.Top" Value="{Binding SurfaceY}" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid
                                                                        Width="{Binding SurfaceWidth}"
                                                                        Height="{Binding SurfaceHeight}">
                                                                        <Border
                                                                            Background="#3390CDF4"
                                                                            BorderThickness="2"
                                                                            MouseLeftButtonDown="OnZoneSurfaceZoneMouseLeftButtonDown"
                                                                            Tag="{Binding Id}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Background" Value="#554F46E5" />
                                                                                            <Setter Property="BorderBrush" Value="#312E81" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>

                                                                        <TextBlock
                                                                            Margin="6,4,6,0"
                                                                            VerticalAlignment="Top"
                                                                            Foreground="#FFFFFF"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding DisplayName}"
                                                                            TextTrimming="CharacterEllipsis" />

                                                                        <Border
                                                                            Width="10"
                                                                            Height="10"
                                                                            Background="#FFFFFF"
                                                                            BorderBrush="#312E81"
                                                                            BorderThickness="1"
                                                                            Canvas.Left="{Binding SurfaceHandleX}"
                                                                            Canvas.Top="{Binding SurfaceHandleY}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            MouseLeftButtonDown="OnZoneResizeHandleMouseLeftButtonDown"
                                                                            Tag="{Binding Id}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border
                                                            Canvas.Left="{Binding ZoneSelectionPreviewX}"
                                                            Canvas.Top="{Binding ZoneSelectionPreviewY}"
                                                            Width="{Binding ZoneSelectionPreviewWidth}"
                                                            Height="{Binding ZoneSelectionPreviewHeight}"
                                                            Background="#2290CDF4"
                                                            BorderBrush="#0F766E"
                                                            BorderThickness="2"
                                                            Visibility="{Binding HasZoneSelectionPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Canvas>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <ListBox
                                                Grid.Column="0"
                                                Height="240"
                                                Background="#FDFDFD"
                                                BorderBrush="#D7DEE8"
                                                BorderThickness="1"
                                                ItemsSource="{Binding OcrZones}"
                                                SelectedItem="{Binding SelectedZone, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8">
                                                            <StackPanel>
                                                                <TextBlock
                                                                    Foreground="#253238"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding DisplayName}" />
                                                                <TextBlock
                                                                    Margin="0,4,0,0"
                                                                    Foreground="#56616F"
                                                                    FontSize="11"
                                                                    Text="{Binding AbsoluteBoundsSummary}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <Border
                                                Grid.Column="2"
                                                Background="#F9FBFD"
                                                BorderBrush="#D7DEE8"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                IsEnabled="{Binding HasSelectedZone}"
                                                Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#253238"
                                                    Text="Zone name" />
                                                <TextBox
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="8,6"
                                                    Text="{Binding SelectedZone.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                                <Border
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,12,0,0"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D7DEE8"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Foreground="#253238"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding SelectedZone.DisplayName}" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.AbsoluteBoundsSummary}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.RelativeBoundsSummary}" />
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="88" />
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar
                                                                Grid.Column="0"
                                                                Height="10"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Value="{Binding SelectedZone.RelativeAreaPercent, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="#2A5D67"
                                                                Text="{Binding SelectedZone.RelativeAreaPercent, StringFormat={}{0:F2}%}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.AbsoluteArea, StringFormat=Area {0} px}" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,12,0,0"
                                                    VerticalAlignment="Top"
                                                    Foreground="#253238"
                                                    Text="Absolute bounds" />
                                                <UniformGrid
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,12,0,0"
                                                    Columns="4">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="X" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.AbsoluteX, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Y" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.AbsoluteY, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="W" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.AbsoluteWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,0,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="H" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.AbsoluteHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,12,0,0"
                                                    VerticalAlignment="Top"
                                                    Foreground="#253238"
                                                    Text="Relative bounds" />
                                                <UniformGrid
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,12,0,0"
                                                    Columns="4">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="X" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.RelativeX, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="Y" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.RelativeY, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,6,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="W" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.RelativeWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6,0,0,0">
                                                        <TextBlock Margin="0,0,0,4" Foreground="#56616F" Text="H" />
                                                        <TextBox Padding="8,6" Text="{Binding SelectedZone.RelativeHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <TextBlock
                                                    Grid.Row="4"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,12,0,0"
                                                    Foreground="#56616F"
                                                    Text="Absolute values are pixel-based. Relative values stay within 0..1 and are useful for future resolution-aware workflows." />

                                                <Border
                                                    Grid.Row="5"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,12,0,0"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D7DEE8"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Padding="12,6"
                                                            Command="{Binding RefreshCapturePreviewCommand}"
                                                            Content="Refresh preview" />
                                                        <Button
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="12,6"
                                                            Command="{Binding MeasureCaptureRefreshCommand}"
                                                            Content="Measure FPS" />
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="#56616F"
                                                            Text="{Binding CapturePreviewStatus}" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,8,0,0"
                                                            Foreground="#2A5D67"
                                                            Text="{Binding CaptureRefreshMetricsSummary}" />
                                                        <Button
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Margin="0,10,0,0"
                                                            Padding="12,6"
                                                            Command="{Binding RecognizeOcrPreviewCommand}"
                                                            Content="Recognize OCR" />
                                                        <Button
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Margin="8,10,0,0"
                                                            Padding="12,6"
                                                            Command="{Binding RunTranslationPipelineCommand}"
                                                            Content="Run pipeline" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="2"
                                                            Margin="12,10,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="#56616F"
                                                            Text="{Binding OcrPreviewStatus}" />
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,8,0,0"
                                                            Foreground="#2A5D67"
                                                            Text="{Binding PipelineStatus}" />
                                                        <Button
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Margin="0,10,0,0"
                                                            Padding="12,6"
                                                            Command="{Binding CleanupTranslationCacheCommand}"
                                                            Content="Clean cache" />
                                                        <TextBlock
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="12,10,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="#56616F"
                                                            Text="{Binding TranslationCacheStatus}" />
                                                        <ItemsControl
                                                            Grid.Row="5"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,10,0,0"
                                                            ItemsSource="{Binding OcrDebugTextBlocks}"
                                                            Visibility="{Binding HasOcrPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Margin="0,0,0,6"
                                                                        Background="#F8FAFC"
                                                                        BorderBrush="#E2E8F0"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="8">
                                                                        <DockPanel>
                                                                            <TextBlock
                                                                                DockPanel.Dock="Right"
                                                                                Margin="12,0,0,0"
                                                                                Foreground="#2A5D67"
                                                                                Text="{Binding CoordinatesSummary}" />
                                                                            <TextBlock
                                                                                Foreground="#253238"
                                                                                Text="{Binding Text}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border
                                                            Grid.Row="6"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,10,0,0"
                                                            Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Height="160"
                                                            Visibility="{Binding HasCapturePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Viewbox Stretch="Uniform">
                                                                <Grid
                                                                    Width="{Binding CapturePreviewWidth}"
                                                                    Height="{Binding CapturePreviewHeight}">
                                                                    <Image
                                                                        Source="{Binding CapturePreviewImage}"
                                                                        Stretch="Fill"
                                                                        SnapsToDevicePixels="True" />
                                                                    <ItemsControl
                                                                        IsHitTestVisible="False"
                                                                        ItemsSource="{Binding OcrDebugTextBlocks}"
                                                                        Visibility="{Binding HasOcrPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid
                                                                                    Width="{Binding Width}"
                                                                                    Height="{Binding Height}">
                                                                                    <Border
                                                                                        Background="#3300828A"
                                                                                        BorderBrush="#00828A"
                                                                                        BorderThickness="2" />
                                                                                    <TextBlock
                                                                                        Margin="3"
                                                                                        Padding="3,1"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        Background="#EFFFFFFF"
                                                                                        Foreground="#253238"
                                                                                        FontSize="12"
                                                                                        Text="{Binding CoordinatesSummary}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTip="{Binding DebugLabel}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                                <Button
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding SaveProfileCommand}"
                                    Content="Save" />
                                <Button
                                    DockPanel.Dock="Right"
                                    Padding="14,8"
                                    Command="{Binding ResetEditorCommand}"
                                    Content="Reset" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#253238">
            <DockPanel LastChildFill="False" Margin="20,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Text="{Binding ApplicationName}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Foreground="#B9D8D4"
                    Text="{Binding CurrentStage}" />
            </DockPanel>
        </Border>

        <ContentControl
            Grid.Row="1"
            Margin="24"
            Content="{Binding Navigation.CurrentViewModel}" />

        <StatusBar Grid.Row="2" Background="#EEF2F6">
            <TextBlock Text="Ready" />
        </StatusBar>
    </Grid>
</UserControl>
