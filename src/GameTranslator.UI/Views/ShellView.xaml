                                                                Content="Включает полужирное начертание перевода для выбранной зоны. Значения: включено или выключено." />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Row="4"
                                                            Grid.Column="3"
                                                            Margin="4,24,0,0"
                                                            VerticalAlignment="Top"
                                                            Orientation="Horizontal">
                                                            <CheckBox
                                                                Content="Italic"
                                                                IsChecked="{Binding SelectedZone.OverlayIsItalic, Mode=TwoWay}" />
