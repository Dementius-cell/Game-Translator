<UserControl x:Class="GameTranslator.UI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GameTranslator.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:MainViewModel}">
            <Border
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#56616F"
                    Text="{Binding StatusMessage}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#253238">
            <DockPanel LastChildFill="False" Margin="20,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Text="{Binding ApplicationName}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Foreground="#B9D8D4"
                    Text="{Binding CurrentStage}" />
            </DockPanel>
        </Border>

        <ContentControl
            Grid.Row="1"
            Margin="24"
            Content="{Binding Navigation.CurrentViewModel}" />

        <StatusBar Grid.Row="2" Background="#EEF2F6">
            <TextBlock Text="Ready" />
        </StatusBar>
    </Grid>
</UserControl>
