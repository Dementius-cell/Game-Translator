                                                                <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Candidate grouping - maximum horizontal lines" />
                                                                <ContentControl
                                                                    Style="{StaticResource ParameterInfoIconStyle}"
                                                                    Tag="HorizontalCandidateGrouping"
                                                                    Content="Auto использует правила текущей письменности и продолжает только строго связанный горизонтальный блок; для SpacedLeftToRight фиксированного числа строк нет. Ручное значение задаёт жёсткий предел 1–12 строк." />
                                                            </StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <CheckBox
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Content="Auto"
                                                                    IsChecked="{Binding SelectedZone.UseAutomaticHorizontalCandidateGroupingLimit, Mode=TwoWay}" />
                                                                <TextBox
                                                                    Width="72"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="6,3"
                                                                    IsEnabled="{Binding SelectedZone.IsCustomHorizontalCandidateGroupingLimit}"
                                                                    Text="{Binding SelectedZone.MaximumHorizontalCandidateLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                                                <TextBlock
                                                                    Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#56616F"
                                                                    Text="Auto keeps writing-system limits and only extends a strongly aligned bubble."
                                                                    TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Row="3"
                                                            Grid.ColumnSpan="4"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsVerticalOcrOrientation, Converter={StaticResource BooleanToVisibilityConverter}}">
