                                                                <TextBlock VerticalAlignment="Center" Foreground="#56616F" Text="Candidate grouping - maximum vertical columns" />
                                                                <ContentControl
                                                                    Style="{StaticResource ParameterInfoIconStyle}"
                                                                    Tag="VerticalCandidateGrouping"
                                                                    Content="Auto определяет границу по геометрии; для вертикального CJK фиксированного числа колонок нет. Ручное значение задаёт жёсткий предел 1–12 колонок." />
                                                            </StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <CheckBox
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Content="Auto"
                                                                    IsChecked="{Binding SelectedZone.UseAutomaticVerticalCandidateGroupingLimit, Mode=TwoWay}" />
                                                                <TextBox
                                                                    Width="72"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="6,3"
                                                                    IsEnabled="{Binding SelectedZone.IsCustomVerticalCandidateGroupingLimit}"
