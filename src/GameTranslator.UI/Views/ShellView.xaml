<UserControl x:Class="GameTranslator.UI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:GameTranslator.UI.Behaviors"
             xmlns:viewModels="clr-namespace:GameTranslator.UI.ViewModels"
              mc:Ignorable="d"
              FontFamily="Segoe UI"
              d:DesignHeight="450"
              d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D2DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F7F8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6DAAB0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3F0F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F3F5F7" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#DCE2E8" />
                                <Setter Property="Foreground" Value="#98A2AD" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#087F8C" />
            <Setter Property="BorderBrush" Value="#087F8C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PrimaryChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Background" Value="#096F7A" />
                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#096F7A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Background" Value="#075D67" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryChrome" Property="Background" Value="#AABFC2" />
                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#AABFC2" />
                                <Setter Property="Foreground" Value="#F5F7F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Foreground" Value="#A33A3A" />
            <Setter Property="BorderBrush" Value="#E0B8B8" />
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE3E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="SubtleCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="#F8FAFB" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212B" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="#4B5865" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ParameterInfoIconStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="AutomationProperties.Name" Value="Справка по параметру" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border
                                x:Name="InfoCircle"
                                Background="#F3F8F9"
                                BorderBrush="#6C8790"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#365963"
                                    Text="i" />
                            </Border>
                            <Popup
                                AllowsTransparency="True"
                                HorizontalOffset="6"
                                IsHitTestVisible="False"
                                IsOpen="{Binding IsMouseOver, ElementName=InfoCircle, Mode=OneWay}"
                                Placement="Right"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                PopupAnimation="Fade"
                                StaysOpen="False"
                                VerticalOffset="-4">
                                <Border
                                    MaxWidth="380"
                                    Padding="10,8"
                                    Background="#FFFDFB"
                                    BorderBrush="#9AAAB2"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Direction="315"
                                            Opacity="0.22"
                                            ShadowDepth="3" />
                                    </Border.Effect>
                                    <TextBlock
                                        Foreground="#17212B"
                                        LineHeight="18"
                                        MaxWidth="356"
                                        Text="{TemplateBinding Content}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoCircle" Property="Background" Value="#DDEFF1" />
                                <Setter TargetName="InfoCircle" Property="BorderBrush" Value="#087F8C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66727F" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PipelineStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#087F55" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PipelineStatusSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PipelineStatusSeverity}" Value="Error">
                    <Setter Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D2DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#FFF8F8" />
                    <Setter Property="BorderBrush" Value="#C84B4B" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D2DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17212B" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#C84B4B" />
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D2DC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#33414E" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="SelectionCard"
                            Background="#FFFFFF"
                            BorderBrush="#DCE3E9"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionCard" Property="BorderBrush" Value="#79AEB4" />
                                <Setter TargetName="SelectionCard" Property="Background" Value="#F5FAFB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionCard" Property="BorderBrush" Value="#087F8C" />
                                <Setter TargetName="SelectionCard" Property="BorderThickness" Value="3,1,1,1" />
                                <Setter TargetName="SelectionCard" Property="Background" Value="#EDF7F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border BorderBrush="#DCE3E9" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#33414E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="TabChrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#F3F8F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#087F8C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#087F8C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type viewModels:MainViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ProfileRail"
                    Grid.Column="0"
                    Background="#F8FAFB"
                    BorderBrush="#DCE3E9"
                    BorderThickness="0,0,1,0"
                    Padding="14,10,14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#17212B"
                                Text="Profiles" />
                            <UniformGrid Margin="0,6,0,0" Columns="4">
                                <Button
                                    Margin="0,0,4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding BeginCreateProfileCommand}"
                                    Content="New" />
                                <Button
                                    Margin="2,0,4,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ImportProfileCommand}"
                                    Content="Import" />
                                <Button
                                    Margin="4,0,2,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ExportSelectedProfileCommand}"
                                    Content="Export" />
                                <Button
                                    Margin="4,0,0,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding RefreshProfilesCommand}"
                                    Content="Refresh" />
                            </UniformGrid>
                        </StackPanel>

                        <ListBox
                            Grid.Row="2"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Tag="{Binding Id}"
                                        ToolTip="Double-click the profile name to rename it."
                                        MouseLeftButtonDown="OnProfileItemMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#DDEFF1"
                                            CornerRadius="15">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="#087F8C"
                                                Text="GT" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    FontSize="14"
                                                    Foreground="#17212B"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.IsProfileRenameActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox
                                                    x:Name="ProfileRenameTextBox"
                                                    MinHeight="28"
                                                    Padding="5,2"
                                                    Text="{Binding DataContext.ProfileRenameText, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    KeyDown="OnProfileRenameKeyDown"
                                                    LostKeyboardFocus="OnProfileRenameLostKeyboardFocus">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.IsProfileRenameActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="#66727F">
                                                <Run Text="{Binding TranslatorSettings.SourceLanguage}" />
                                                <Run Text=" to " />
                                                <Run Text="{Binding TranslatorSettings.TargetLanguage}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Grid.Row="3" Margin="0,4,0,0" Columns="2">
                            <Button
                                Margin="0,0,4,0"
                                Padding="9,4"
                                Command="{Binding CloneSelectedProfileCommand}"
                                Content="Clone" />
                            <Button
                                Margin="4,0,0,0"
                                Padding="9,4"
                                Command="{Binding DeleteSelectedProfileCommand}"
                                Content="Delete"
                                Style="{StaticResource DangerButtonStyle}" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Background="#FBFCFD"
                    BorderThickness="0"
                    Padding="0">
                    <ScrollViewer
                        x:Name="WorkspaceScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Border
                            Width="{Binding ActualWidth, ElementName=WorkspaceScrollViewer}"
                            Padding="18,12,18,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#17212B"
                                    Text="{Binding ApplicationName}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#66727F">
                                        <Run Text="Active profile: " />
                                        <Run FontWeight="SemiBold" Foreground="#087F8C" Text="{Binding ActiveProfileName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel
                                    x:Name="WorkspaceHeaderActions"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="WelcomeTourHeaderButton"
                                        MinWidth="56"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Открыть приветственный тур"
                                        Command="{Binding ShowWelcomeTourCommand}"
                                        Content="? Тур"
                                        Style="{StaticResource CompactButtonStyle}"
                                        ToolTip="Открыть приветственный тур по базовой настройке профиля." />
                                    <Button
                                        MinWidth="78"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartLiveTranslationCommand}"
                                        Content="Start live"
                                        ToolTip="Start live translation for the active profile." />
                                    <Button
                                        MinWidth="74"
                                        Margin="4,0,0,0"
                                        Command="{Binding StopLiveTranslationCommand}"
                                        Content="Stop live"
                                        ToolTip="Stop live translation and save the automatic stop report." />
                                    <Button
                                        MinWidth="66"
                                        Margin="10,0,0,0"
                                        Command="{Binding ResetEditorCommand}"
                                        Content="Reset" />
                                    <Button
                                        MinWidth="86"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveProfileCommand}"
                                        Content="Save profile" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Margin="0,0,0,2"
                                Background="#FFF4F4"
                                BorderBrush="#E3B4B4"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,1"
                                                Foreground="#8B1E1E"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Expander
                                Margin="0,4,0,0"
                                HorizontalContentAlignment="Stretch"
                                Header="Edit profile details"
                                IsExpanded="False">
                                <Border Margin="0,4,0,0" Style="{StaticResource SubtleCardBorderStyle}">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#253238"
                                            Text="Name" />
                                        <ContentControl
                                            Style="{StaticResource ParameterInfoIconStyle}"
                                            Tag="ProfileName"
                                            Content="Имя профиля используется в списке и при сохранении. Поле обязательно; фиксированного ограничения длины нет." />
                                    </StackPanel>
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="6,3"
                                        Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#253238"
                                            Text="Description" />
                                        <ContentControl
                                            Style="{StaticResource ParameterInfoIconStyle}"
                                            Tag="ProfileDescription"
                                            Content="Необязательное описание назначения профиля. Допускается пустое значение; фиксированного ограничения длины нет." />
                                    </StackPanel>
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,6,0,0"
                                        Padding="6,3"
                                        AcceptsReturn="True"
                                        Height="64"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </Expander>

                            <TabControl
                                Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource WorkspaceTabControlStyle}"
                                SelectedIndex="{Binding SelectedWorkspaceTabIndex, Mode=TwoWay}">
                                <TabItem Header="Zones &amp; OCR" Style="{StaticResource WorkspaceTabItemStyle}" />
