<Window x:Class="GameTranslator.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Translator Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Canvas
        Background="Transparent"
        IsHitTestVisible="False">
        <ItemsControl
            IsHitTestVisible="False"
            ItemsSource="{Binding MaskItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Background="{Binding Brush}"
                        Opacity="{Binding Opacity}"
                        Tag="{Binding Mode}"
                        RenderOptions.ClearTypeHint="Enabled"
                        SnapsToDevicePixels="True" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl
            IsHitTestVisible="False"
            ItemsSource="{Binding TextItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Background="{Binding BackgroundBrush}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="1"
                        RenderOptions.ClearTypeHint="Enabled"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Viewbox
                                Stretch="Uniform"
                                StretchDirection="Both"
                                Visibility="{Binding UsesFitToSourceBounds, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Width="{Binding ContentWidth}"
                                    Foreground="{Binding TextBrush}"
                                    FontFamily="{Binding FontFamily}"
                                    FontSize="{Binding FontSize}"
                                    FontStyle="{Binding FontStyle}"
                                    FontWeight="{Binding FontWeight}"
                                    Text="{Binding Text}"
                                    TextAlignment="Center"
                                    TextTrimming="None"
                                    TextWrapping="Wrap" />
                            </Viewbox>
                            <TextBlock
                                Width="{Binding ContentWidth}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{Binding TextBrush}"
                                FontFamily="{Binding FontFamily}"
                                FontSize="{Binding FontSize}"
                                FontStyle="{Binding FontStyle}"
                                FontWeight="{Binding FontWeight}"
                                Text="{Binding Text}"
                                TextAlignment="Center"
                                TextTrimming="None"
                                TextWrapping="Wrap"
                                Visibility="{Binding UsesExpandedLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl
            IsHitTestVisible="False"
            ItemsSource="{Binding DebugItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Width="{Binding Width}"
                        Height="{Binding Height}">
                        <Border
                            Background="#1600D4FF"
                            BorderBrush="#00D4FF"
                            BorderThickness="2"
                            SnapsToDevicePixels="True" />
                        <TextBlock
                            Margin="3"
                            Padding="4,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#DD111827"
                            Foreground="#E0F2FE"
                            FontSize="11"
                            Text="{Binding Label}"
                            TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border
            Canvas.Left="12"
            Canvas.Top="12"
            Padding="8"
            Background="#DD111827"
            BorderBrush="#00D4FF"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding HasDebugMetricLines, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding DebugMetricLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,0,0,2"
                            Foreground="#E0F2FE"
                            FontSize="12"
                            Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Canvas>
</Window>
