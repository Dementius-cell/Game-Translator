                                                <UniformGrid
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,6,0,0"
                                                    Columns="4"
                                                    Visibility="{Binding IsZonesOcrTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Margin="0,0,0,2" Foreground="#56616F" Text="X" />
                                                        <TextBox Padding="6,3" Text="{Binding SelectedZone.RelativeX, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
