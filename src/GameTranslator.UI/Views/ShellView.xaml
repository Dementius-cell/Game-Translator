                                                                                DockPanel.Dock="Right"
                                                                                Margin="4,0,0,0"
                                                                                Foreground="#2A5D67"
                                                                                Text="{Binding CoordinatesSummary}" />
                                                                            <TextBlock
                                                                                Foreground="#253238"
                                                                                Text="{Binding Text}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border
                                                            Grid.Row="10"
                                                            Grid.ColumnSpan="4"
                                                            Margin="0,6,0,0"
                                                            Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Height="140"
                                                            Visibility="{Binding HasCapturePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Viewbox Stretch="Uniform">
                                                                <Grid
                                                                    Width="{Binding CapturePreviewWidth}"
                                                                    Height="{Binding CapturePreviewHeight}">
                                                                    <Image
                                                                        Source="{Binding CapturePreviewImage}"
                                                                        Stretch="Fill"
                                                                        SnapsToDevicePixels="True" />
                                                                    <ItemsControl
                                                                        IsHitTestVisible="False"
                                                                        ItemsSource="{Binding OcrDebugTextBlocks}"
                                                                        Visibility="{Binding HasOcrPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid
                                                                                    Width="{Binding Width}"
                                                                                    Height="{Binding Height}"
                                                                                    Visibility="{Binding IsVisibleOnCapturePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Border
                                                                                        Background="#3300828A"
                                                                                        BorderBrush="#00828A"
                                                                                        BorderThickness="2" />
                                                                                    <TextBlock
                                                                                        Margin="3"
                                                                                        Padding="3,1"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        Background="#EFFFFFFF"
                                                                                        Foreground="#253238"
                                                                                        FontSize="12"
                                                                                        Text="{Binding CoordinatesSummary}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTip="{Binding DebugLabel}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                        </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Border>

                <Grid
                    x:Name="WelcomeTourOverlay"
                    Grid.ColumnSpan="3"
                    Panel.ZIndex="1000"
                    Background="Transparent"
                    IsVisibleChanged="OnWelcomeTourOverlayIsVisibleChanged"
                    LayoutUpdated="OnWelcomeTourOverlayLayoutUpdated"
                    Visibility="{Binding IsWelcomeTourVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path
                        x:Name="WelcomeTourDimmingPath"
                        Panel.ZIndex="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Fill="#66192731"
                        IsHitTestVisible="False"
                        Stretch="None" />
                    <Border
                        x:Name="WelcomeTourSpotlightBorder"
                        Panel.ZIndex="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#12FFFFFF"
                        BorderBrush="#22D3C5"
                        BorderThickness="3"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Color="#0AA6A6"
                                Opacity="0.9"
                                ShadowDepth="0" />
                        </Border.Effect>
                    </Border>
                    <Border
                        x:Name="WelcomeTourCard"
                        Panel.ZIndex="2"
                        Width="620"
                        Margin="24"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Приветственный тур по Game Translator"
                        Background="#FFFFFF"
                        BorderBrush="#B7C4CC"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="24"
                                Direction="270"
                                Opacity="0.32"
                                ShadowDepth="8" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#087F8C"
                                    Text="Быстрый старт" />
                                <Button
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Закрыть приветственный тур"
                                    Command="{Binding CloseWelcomeTourCommand}"
                                    Content="×"
                                    FontSize="20"
                                    FontWeight="Normal"
                                    ToolTip="Закрыть приветственный тур" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="#56616F"
                                    Text="{Binding WelcomeTourStepIndicator}" />
                                <ProgressBar
                                    Grid.Column="1"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Maximum="{Binding WelcomeTourStepCount}"
                                    Minimum="0"
                                    Value="{Binding WelcomeTourProgress, Mode=OneWay}" />
                            </Grid>

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,18,0,0"
                                FontSize="23"
                                FontWeight="SemiBold"
                                Foreground="#17212B"
                                Text="{Binding WelcomeTourTitle}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                FontSize="14"
                                Foreground="#33414E"
                                LineHeight="21"
                                Text="{Binding WelcomeTourBody}"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Row="4"
                                Margin="0,16,0,0"
                                Padding="12,10"
                                Background="#EDF7F8"
                                BorderBrush="#B9DCDD"
                                BorderThickness="1"
                                CornerRadius="5">
                                <DockPanel>
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top"
                                        Background="#087F8C"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#FFFFFF"
                                            Text="i" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#254B52"
                                        LineHeight="19"
                                        Text="{Binding WelcomeTourGuidance}"
                                        TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="5" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="#66727F"
                                    Text="Тур ничего не меняет автоматически."
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    Margin="8,0,0,0"
                                    Command="{Binding PreviousWelcomeTourStepCommand}"
                                    Content="Назад"
                                    IsEnabled="{Binding WelcomeTourCanGoBack}" />
                                <Button
                                    Grid.Column="2"
                                    MinWidth="104"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NextWelcomeTourStepCommand}"
                                    Content="{Binding WelcomeTourPrimaryActionText}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10242C">
            <DockPanel LastChildFill="False" Margin="16,0">
                <Border
                    Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    BorderBrush="#B9D8D4"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="GT" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Text="{Binding ApplicationName}" />
            </DockPanel>
        </Border>

        <ContentControl
            Grid.Row="1"
            Margin="0"
            Content="{Binding Navigation.CurrentViewModel}" />

        <StatusBar
            Grid.Row="2"
            Padding="16,0"
            Background="#F8FAFB"
            BorderBrush="#DCE3E9"
            BorderThickness="0,1,0,0">
            <TextBlock Foreground="#66727F" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </StatusBar>
    </Grid>
</UserControl>
