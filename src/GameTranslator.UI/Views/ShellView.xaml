                                                                    Content="Порог принятия Paddle-кандидатов: Standard 0,60; Chinese test 0,65; Chinese strict test 0,70. Китайские тестовые пресеты для других языков безопасно сводятся к Standard." />
                                                            </StackPanel>
                                                            <ComboBox
                                                                Padding="6,3"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding CandidateDetectorPresetOptions}"
                                                                SelectedValue="{Binding SelectedZone.DetectorPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                                SelectedValuePath="Preset"
                                                                ToolTip="{Binding SelectedZone.DetectorPresetSummary}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Margin="0,6,4,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="#56616F"
                                                            Text="Mode policy" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,6,0,0"
                                                            Foreground="#56616F"
                                                            Text="{Binding SelectedZone.ContentLayoutPolicySummary}"
                                                            TextWrapping="Wrap" />
                                                        <StackPanel
                                                            Grid.Row="3"
                                                            Grid.ColumnSpan="4"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsHorizontalOcrOrientation, Converter={StaticResource BooleanToVisibilityConverter}}">
